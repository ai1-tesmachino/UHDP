CLOUD_DATABASE_URL=postgresql://uhdp:replace-with-a-long-random-password@127.0.0.1:5432/uhdp
POSTGRES_PASSWORD=replace-with-a-long-random-password
CLOUD_JWT_SECRET=replace-with-at-least-32-random-bytes
CLOUD_JWT_LIFETIME_SECONDS=900

# Configure all object storage values together to enable evidence cloud sync.
# Keep the bucket private and use its externally reachable HTTPS endpoint.
# OBJECT_STORAGE_ENDPOINT=https://s3.example.com
# OBJECT_STORAGE_BUCKET=uhdp-evidence
# OBJECT_STORAGE_ACCESS_KEY=replace-me
# OBJECT_STORAGE_SECRET_KEY=replace-me
# OBJECT_STORAGE_REGION=us-east-1
