APP_NAME=UHDP
APP_VERSION=1.0.0
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
SESSION_TIMEOUT_MINUTES=60
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
STORAGE_BACKEND=sqlite

# Defaults to ${DATA_DIR}/uhdp.sqlite3 when not set.
# SQLITE_DATABASE_PATH=/var/lib/uhdp/uhdp.sqlite3

# Optional cloud sync credentials. Keep this backend-only file owner-readable.
# CLOUD_API_URL=https://cloud.example.com
# CLOUD_STATION_TOKEN=provisioned-per-station-token

# For hosted persistence, set STORAGE_BACKEND=supabase and configure these
# backend-only values. Never expose the service-role key in the frontend.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_RECORDS_TABLE=uhdp_records
